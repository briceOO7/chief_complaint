# Copy to .env and fill in your API keys.
# .env is gitignored — never commit it.

# OpenAI (for GPT-4o-mini panel member)
OPENAI_API_KEY=sk-...

# Anthropic (for Claude adjudicator)
ANTHROPIC_API_KEY=sk-ant-...

# Google (for Gemini panel member)
GOOGLE_API_KEY=AI...

# Azure OpenAI (optional — if using Azure instead of direct OpenAI)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://....openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01

# Stanford AI Hub — covers BOTH Azure AI Foundry and AWS Bedrock endpoints
# Get from: https://aihub.stanfordhealthcare.edu → Profile → API Keys
PRIMARY_API_KEY=...

# Stanford APIM — covers SecureGPT (gpt-4o, gpt-5, gpt-5-mini, gpt-5-nano) and Llama
APIM_API_KEY=...
